[Unit]
Description=NextBus Dev API (.NET 8)
After=network.target

[Service]
WorkingDirectory=/var/www/nextbus-dev-api
ExecStart=/usr/bin/dotnet /var/www/nextbus-dev-api/NextBus.API.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=nextbus-dev-api
User=www-data

# Environment configuration
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5070
Environment=DOTNET_CLI_HOME=/tmp
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1

# Optional external environment file for production secrets (DB credentials, etc.)
EnvironmentFile=-/etc/nextbus-api/nextbus-dev-api.env

[Install]
WantedBy=multi-user.target
